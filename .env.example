DATABASE_URL=postgres://nummo:nummo@localhost:5434/nummo
PORT=8787

# Settlement. Without a puller key, checkout and the worker are off for that environment.
# The puller is a hot wallet: it signs pulls and pays fees and rent. Keep only a little SOL in it.
# NUMMO_TEST_PULLER_KEY=./keys/puller.json      # keypair file, or the JSON byte array itself
# NUMMO_TEST_RPC_URL=https://api.devnet.solana.com
# NUMMO_TEST_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU   # devnet USDC
# NUMMO_PUBLIC_URL=http://localhost:8787        # base of checkout links
# NUMMO_TEST_PRIORITY_FEE=0                     # micro-lamports per compute unit

# Mainnet (live keys). Real money: read docs/guide/deploy.md first. Use a new puller, never the devnet one.
# NUMMO_LIVE_PULLER_KEY=./keys/live-puller.json
# NUMMO_LIVE_RPC_URL=https://your-provider.example   # the public mainnet RPC rate-limits
# NUMMO_LIVE_PRIORITY_FEE=10000                      # default on mainnet
# NUMMO_LIVE_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v   # mainnet USDC (the default; others need NUMMO_LIVE_ALLOW_MINT)

# Settlement policy (doc 03). Defaults shown.
# NUMMO_SETTLEMENT_THRESHOLD=5                  # USDC of accrued overage before a pull
# NUMMO_RETRY_SCHEDULE=1h,6h,24h,72h            # retries after a failed pull, from the first failure
# NUMMO_BOUNDARY_MARGIN=60s                     # wait after a period boundary before the renewal pull
# NUMMO_SETTLE_EVERY=10s
# NUMMO_RECONCILE_EVERY=2m
