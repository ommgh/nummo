{
  "name": "@usenummo/core",
  "version": "0.1.0",
  "description": "Pure billing rules: quantities, money, periods, deduction order, overage. No I/O.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ommgh/nummo.git"
  },
  "homepage": "https://github.com/ommgh/nummo#readme",
  "bugs": "https://github.com/ommgh/nummo/issues",
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "billing",
    "usage-based-billing",
    "metering",
    "credits",
    "entitlements",
    "solana",
    "stablecoin",
    "usdc",
    "subscriptions"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-packages.ts core",
    "prepack": "node ../../scripts/build-packages.ts core"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
