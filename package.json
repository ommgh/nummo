{
  "name": "nummo-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.1.0",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @usenummo/db generate",
    "db:migrate": "pnpm --filter @usenummo/db migrate",
    "dev:api": "pnpm --filter @usenummo/api dev",
    "dev:worker": "pnpm --filter @usenummo/worker dev",
    "nummo": "node --env-file-if-exists=.env packages/cli/src/main.ts",
    "e2e:devnet": "node --env-file-if-exists=.env e2e/devnet.ts",
    "dev:web": "pnpm --filter @usenummo/web dev",
    "build:web": "pnpm --filter @usenummo/web build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
